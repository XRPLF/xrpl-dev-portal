# Copy to .env and adjust as needed. All values have safe Devnet defaults.

# WebSocket endpoint of an XRPL node with the ConfidentialTransfer, BatchV1_1,
# and Sponsor amendments enabled.
VITE_XRPL_WSS=wss://s.devnet.rippletest.net:51233

# Block explorer used for transaction links.
VITE_EXPLORER_URL=https://devnet.xrpl.org

# Optional: pin the demo to existing funded accounts instead of asking the
# faucet for fresh ones on every run. Never commit real seeds; .env is
# gitignored. Leave these empty to use the faucet.
VITE_ALPHAFUND_SEED=
VITE_STABLECORP_SEED=
VITE_INVESTCO_SEED=
VITE_TRADEDESK_SEED=
VITE_XSECURITIES_SEED=
